<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MCQ Builder + Practice"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Paste ChatGPT MCQ Details" />

        <EditText
            android:id="@+id/etQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Question" />

        <EditText
            android:id="@+id/etOptionA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Option A" />

        <EditText
            android:id="@+id/etOptionB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Option B" />

        <EditText
            android:id="@+id/etOptionC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Option C" />

        <EditText
            android:id="@+id/etOptionD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Option D" />

        <EditText
            android:id="@+id/etCorrectOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Correct Option (A/B/C/D)" />

        <Button
            android:id="@+id/btnAddMcq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Add MCQ" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Saved MCQs: 0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#DDDDDD" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Practice Mode"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPracticeQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No MCQ yet. Add your first question from ChatGPT above." />

        <RadioGroup
            android:id="@+id/rgPracticeOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/rbOptionA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Option A" />

            <RadioButton
                android:id="@+id/rbOptionB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Option B" />

            <RadioButton
                android:id="@+id/rbOptionC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Option C" />

            <RadioButton
                android:id="@+id/rbOptionD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Option D" />
        </RadioGroup>

        <Button
            android:id="@+id/btnCheckAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check Answer" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Next Question" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
